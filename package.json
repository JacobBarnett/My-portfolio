{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^13.5.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.1",
    "react-scripts": "5.0.1",
    "three": "^0.183.2",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && mkdir -p build/static-wasm && cp -R public/static-wasm/. build/static-wasm/",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "wasm:build": "wasm-pack build mining-physics --target web --out-dir pkg --release && cp mining-physics/pkg/mining_physics.js mining-physics/pkg/mining_physics_bg.wasm public/static-wasm/ && cp mining-physics/pkg/mining_physics.js mining-physics/pkg/mining_physics_bg.wasm mining-physics/pkg/mining_physics.d.ts src/wasm/",
    "wasm:build:node": "wasm-pack build mining-physics --target nodejs --out-dir pkg-node --release",
    "test:engine": "npm run wasm:build:node && node --test src/engine/call.node-test.mjs src/flight/playback.node-test.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  }
}
